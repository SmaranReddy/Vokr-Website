# Vokr — environment variable template.
#
# Copy this file to `.env.local` for local development and fill in real
# values there. `.env.local` (and every other `.env*` variant except this
# file) is git-ignored — never commit real secrets.
#
# Stage 1 does not connect to any of these services. The variables below
# are documented now so later stages (see the Vokr production-readiness
# PDF) have a stable, agreed-upon naming convention to build against.
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time.
# Never put a secret behind a NEXT_PUBLIC_ name.

# ---------------------------------------------------------------------------
# Public (safe for the browser)
# ---------------------------------------------------------------------------

# Canonical site URL, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and anon (public) key — safe for the client because
# Row Level Security enforces access control server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay's publishable key ID (safe for the client checkout widget).
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---------------------------------------------------------------------------
# Server-only secrets (never exposed to the client, never prefixed NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Prisma / Postgres connection strings (Supabase). See PDF section 1 —
# transaction-mode pooler with pgbouncer=true for normal queries, and a
# direct/session connection reserved for the checkout transaction.
#
# For local development against `docker-compose.yml`'s Postgres, both
# point at the same local instance. Host port 55432, not 5432 — see
# docker-compose.yml for why:
#   DATABASE_URL=postgresql://vokr:vokr_local_dev@localhost:55432/vokr
#   DIRECT_URL=postgresql://vokr:vokr_local_dev@localhost:55432/vokr
#
# Against the real Supabase project (get these from the dashboard,
# Settings -> Database -> Connection string — never commit real values):
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#
# `prisma migrate deploy` / `prisma db seed` MUST run with DATABASE_URL
# set to the session pooler (the DIRECT_URL value, port 5432) — the
# transaction-mode pooler (6543) rejects Prisma's schema-engine DDL with
# `ERROR: prepared statement "s1" already exists`. Port 6543 is correct
# for the running application's normal queries only. See README.md
# "Database — real Supabase project".
DATABASE_URL=
DIRECT_URL=

# Supabase service role key — full-access, server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay server-side credentials and webhook signature secret.
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Brevo transactional email API key (also used as Supabase Auth custom SMTP).
BREVO_API_KEY=

# Sentry error monitoring DSN and org/project for source maps.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Cloudflare R2 (S3-compatible) — product images and database backups.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ---------------------------------------------------------------------------
# In production these are never read from a .env file — they are loaded
# once at process boot from Google Secret Manager (see PDF section 7, R3).
# This template exists for local development and to document the contract.
# ---------------------------------------------------------------------------
