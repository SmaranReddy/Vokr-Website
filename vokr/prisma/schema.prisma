// Vokr production schema — Phase 2 (catalog + inventory), Phase 3
// (authentication + guest sessions) + Phase 5 (server-side cart). See
// Vokr-Implementation-Plan.md §3.5 for the full entity plan and the
// reasoning behind every constraint below. Orders and payments land in
// later phases. Phase 7 adds payments + webhook_events; Phase 8 adds
// inventory_reservations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Shared by products and variants. A row only becomes purchasable in
/// "active" state; see the `enforce_variant_gst_rate` trigger in the
/// first migration, which additionally refuses an "active" variant on a
/// product with no confirmed GST rate (decision D2, still open).
enum CatalogStatus {
  draft
  active
  archived

  @@map("catalog_status")
}

/// One row per SKU family (e.g. "Model x"). Never a price source itself —
/// see ProductVariant.
model Product {
  id String @id @default(uuid(7)) @db.Uuid

  slug        String @unique
  name        String
  description String
  category    String

  /// Per-product HSN code. Nullable until decision D2 (GST rate + HSN per
  /// SKU, Vokr-Implementation-Plan.md §0.3) is answered. Never invented.
  hsnCode String? @map("hsn_code")

  /// Per-product GST rate in basis points (e.g. 1800 = 18%). Nullable for
  /// the same reason as `hsnCode`. **Never a global constant** — laces and
  /// shoes are not necessarily in the same slab.
  gstRateBps Int? @map("gst_rate_bps")

  status CatalogStatus @default(draft)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  variants ProductVariant[]

  @@map("products")
}

/// The sellable unit. This is the only entity a price may be resolved
/// from — see `src/server/catalog/service.ts` `resolvePrices()`.
model ProductVariant {
  id String @id @default(uuid(7)) @db.Uuid

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  /// Human-readable stable key, e.g. VK-MX-WHTBLK-IN09. Uppercase, unique,
  /// never reused. The SKU is a key, never a display name.
  sku String @unique

  sizeLabel String @map("size_label")
  colorway  String

  /// Integer paise. ₹9,995 is stored as 999500. Never a float.
  pricePaise Int @map("price_paise")

  weightGrams Int @map("weight_grams")

  /// Display order within a product's variant list.
  position Int

  status CatalogStatus @default(draft)

  inventory    Inventory?
  cartItems    CartItem[]
  reservations InventoryReservation[]
  orderItems   OrderItem[]

  @@unique([productId, colorway, sizeLabel])
  @@index([productId, status])
  @@map("product_variants")
}

/// Stock per variant. One row per variant, created alongside it. The row
/// that the Phase 8 reservation transaction locks with
/// `SELECT ... FOR UPDATE`. The three CHECK constraints are the backstop —
/// added by hand in the first migration's SQL because Prisma's schema
/// language has no CHECK-constraint primitive.
model Inventory {
  variantId String         @id @map("variant_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantityOnHand   Int @default(0) @map("quantity_on_hand")
  quantityReserved Int @default(0) @map("quantity_reserved")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("inventory")
}

/// Application profile, 1:1 with a Supabase Auth user. `id` is literally
/// the Supabase `auth.users.id` (a UUID minted by GoTrue, not by us) — no
/// database FK, because `auth` is a separate schema Prisma does not model,
/// but every write path that creates a row here receives that id from a
/// verified Supabase session, never from client input. Living in Vokr's
/// own Postgres (ADR-003) is what makes `orders.user_id` (Phase 9) a real
/// foreign key and DPDP erasure one system rather than two.
model AppUser {
  id String @id @db.Uuid

  email       String  @unique
  displayName String? @map("display_name")

  /// Encrypted at rest (application-layer encryption, not pgcrypto) —
  /// see AGENTS.md "Security & privacy". Nullable: phone is collected at
  /// checkout (Phase 6), not at signup.
  phoneEnc String? @map("phone_enc")

  /// Operator access to `/admin` and `/api/admin` (plan §5 Phase 12, task 1).
  /// Granted only out of band (production SQL by the owner) — no route ever
  /// writes it. Checked on every admin request, never cached client-side.
  isAdmin Boolean @default(false) @map("is_admin")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// DPDP erasure marker (Phase 17). Never a hard delete of a row an
  /// order's `user_id` may still reference.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  carts            Cart[]
  addresses        Address[]
  checkoutSessions CheckoutSession[]
  orders           Order[]
  consentRecords   ConsentRecord[]
  privacyRequests  DataSubjectRequest[]

  @@map("app_users")
}

/// Anonymous identity before sign-in. The raw 256-bit token lives only in
/// an HttpOnly cookie on the customer's device — this table stores a
/// SHA-256 hash of it, never the raw value, so a database read (or a
/// backup, or a future read-replica) can never be turned into a working
/// session token. See `src/server/auth/tokens.ts`.
model GuestSession {
  id String @id @default(uuid(7)) @db.Uuid

  tokenHash String @unique @map("token_hash")

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// 90 days from creation (plan §3.5). Renewed at last-seen time by the
  /// pruning job's window, not by extending this column on every request.
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  carts            Cart[]
  checkoutSessions CheckoutSession[]

  @@index([expiresAt])
  @@map("guest_sessions")
}

/// Postgres-backed fixed-window rate limiting (ADR-006 — no Redis at
/// launch). One row per `(route, identifier)` window; `consumeRateLimit()`
/// in `src/server/rate-limit/` advances or resets the window with a
/// single atomic `INSERT ... ON CONFLICT` so concurrent requests cannot
/// race past the limit. Cumulative growth — the Phase 17/18 pruning job
/// must delete rows older than 24 hours (plan §3.5 retention table).
model RateLimitCounter {
  key String @id

  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)

  @@index([windowStart])
  @@map("rate_limit_counters")
}

/// One open cart per identity — enforced at the database, not just the
/// application, by the two partial unique indexes added by hand in the
/// Phase 5 migration (Prisma's schema language has no partial-index
/// primitive). `closed` marks a cart that has already been merged into a
/// user's cart on sign-in (see `src/server/auth/upgrade.ts`) and is kept
/// only for audit; it is never read from again.
enum CartStatus {
  open
  closed

  @@map("cart_status")
}

/// An *open* cart belongs to exactly one identity — a signed-in user or a
/// guest session, never both, never neither (see the hand-written CHECK
/// in the Phase 5 migration). A `closed` cart is a historical record and
/// may have neither: its guest session is typically deleted moments
/// later by the sign-in that closed it, which nulls `guestSessionId` via
/// the FK. See `src/server/cart/service.ts` for how prices are resolved
/// on every read; this table never stores one.
model Cart {
  id String @id @default(uuid(7)) @db.Uuid

  userId String?  @map("user_id") @db.Uuid
  user   AppUser? @relation(fields: [userId], references: [id])

  guestSessionId String?       @map("guest_session_id") @db.Uuid
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id])

  status CartStatus @default(open)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Bumped on every cart mutation. Drives the 30-day abandoned-cart
  /// pruning job (plan §3.5 retention table) — never used to extend a
  /// cart's life on mere reads.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items            CartItem[]
  checkoutSessions CheckoutSession[]

  @@index([updatedAt])
  @@map("carts")
}

/// A line in a cart. **Stores no price** — `getCart()` resolves unit
/// price, line subtotal and per-variant GST server-side on every read
/// from `product_variants.price_paise` and `products.gst_rate_bps`, never
/// from this row (R6).
model CartItem {
  id String @id @default(uuid(7)) @db.Uuid

  cartId String @map("cart_id") @db.Uuid
  cart   Cart   @relation(fields: [cartId], references: [id])

  variantId String         @map("variant_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity Int

  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Phase 6 — Address + Checkout Foundation. See
// Vokr-Implementation-Plan.md §5 PHASE 6 for scope, and §3.5 for the
// entity plan this follows. GST split (CGST+SGST vs IGST) and the
// pricing snapshot itself are computed in `src/server/pricing/`, never
// stored redundantly beyond the JSONB snapshot below.
// ---------------------------------------------------------------------------

/// A shipping address captured at checkout. **Not** a saved address book —
/// that is explicitly deferred (plan §5 Phase 6, Explicitly Out of Scope).
/// One row per checkout session's address step; `userId` is recorded for
/// provenance only, never read to build a "my addresses" list.
model Address {
  id String @id @default(uuid(7)) @db.Uuid

  userId String?  @map("user_id") @db.Uuid
  user   AppUser? @relation(fields: [userId], references: [id])

  /// Encrypted at rest — application-layer AES-256-GCM, same convention as
  /// `AppUser.phoneEnc` (see `src/server/checkout/crypto.ts`), not pgcrypto.
  nameEnc  String  @map("name_enc")
  line1Enc String  @map("line1_enc")
  line2Enc String? @map("line2_enc")
  phoneEnc String  @map("phone_enc")

  city    String
  /// One of the fixed GST-state enumeration's names (`src/lib/gst-states.ts`)
  /// — matched against the seller's registered state (D3) to decide the
  /// CGST+SGST vs IGST split. Never a free-text state.
  state   String
  pincode String
  country String @default("IN")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  checkoutSessions CheckoutSession[]

  @@index([pincode])
  @@map("addresses")
}

/// `draft → address_captured → priced → reserved → payment_pending →
/// paid | failed | expired | abandoned` (plan §5 Phase 6, task 8). Phase 6
/// only ever drives a session through `draft`, `address_captured` and
/// `priced` — `reserved` is Phase 8 (inventory), `payment_pending`/`paid`/
/// `failed` are Phase 7 (Razorpay). The full enum exists now so later
/// phases extend, rather than redefine, this state machine.
enum CheckoutState {
  draft
  address_captured
  priced
  reserved
  payment_pending
  paid
  failed
  expired
  abandoned

  @@map("checkout_state")
}

enum CheckoutPaymentMethod {
  prepaid
  cod

  @@map("checkout_payment_method")
}

/// The bridge between cart and order (plan §3.5). Holds the single
/// server-computed pricing snapshot that Razorpay's amount (Phase 7) and
/// the order total (Phase 9) both read from, so they cannot disagree.
/// Bound to exactly one caller identity — the same `userId` XOR
/// `guestSessionId` shape as `Cart` — enforced by a hand-written CHECK in
/// this model's migration.
model CheckoutSession {
  id String @id @default(uuid(7)) @db.Uuid

  cartId String @map("cart_id") @db.Uuid
  cart   Cart   @relation(fields: [cartId], references: [id])

  userId String?  @map("user_id") @db.Uuid
  user   AppUser? @relation(fields: [userId], references: [id])

  guestSessionId String?       @map("guest_session_id") @db.Uuid
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id])

  state CheckoutState @default(draft)

  addressId String?  @map("address_id") @db.Uuid
  address   Address? @relation(fields: [addressId], references: [id])

  paymentMethod CheckoutPaymentMethod? @map("payment_method")

  /// Accepted on session creation, unique-constrained (plan §5 Phase 6,
  /// task 10) — the same idempotency key always resolves to the same
  /// session, never a second one.
  idempotencyKey String @unique @map("idempotency_key")

  /// The authoritative price breakdown — see `src/server/pricing/`.
  /// `expiresAt` is always set together with this (15 minutes from
  /// computation), enforced by a hand-written CHECK.
  pricingSnapshot Json?     @map("pricing_snapshot")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)

  /// Where order updates go, and the second factor of guest order lookup
  /// (plan §5 Phase 9, task 6). Encrypted at rest like every other PII
  /// column (`src/server/checkout/crypto.ts`). A guest gives it at the
  /// address step; a signed-in customer's is their account email.
  contactEmailEnc String? @map("contact_email_enc")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment      Payment?
  reservations InventoryReservation[]
  order        Order?

  @@map("checkout_sessions")
}

/// PIN serviceability lookup, seeded manually from a Shiprocket export
/// (plan §5 Phase 6, task 3 — the API integration is deferred). A pincode
/// absent from this table is **not serviceable** — the lookup fails
/// closed rather than guessing.
model ServiceablePincode {
  pincode String @id

  codEligible           Boolean @map("cod_eligible")
  estimatedDeliveryDays Int     @map("estimated_delivery_days")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("serviceable_pincodes")
}

/// Phase 7 (Razorpay Payments). `created → authorized → captured |
/// failed | refunded` — see `src/server/payments/state-machine.ts` for
/// which moves are legal. `failed` describes the latest *attempt*, not the
/// Razorpay order: one order can take several attempts, so a later
/// attempt may still move a `failed` payment to `captured`.
enum PaymentStatus {
  created
  authorized
  captured
  failed
  refunded

  @@map("payment_status")
}

enum PaymentProvider {
  razorpay

  @@map("payment_provider")
}

/// One row per checkout session, written *before* the Razorpay order is
/// created (plan §5 Phase 7, task 4) so a Razorpay order can never exist
/// without a local record. `UNIQUE(checkout_session_id)` is the claim that
/// makes order creation idempotent; `provider_order_id` is null only
/// between that claim and Razorpay's response.
model Payment {
  id String @id @default(uuid(7)) @db.Uuid

  checkoutSessionId String          @unique @map("checkout_session_id") @db.Uuid
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id])

  provider          PaymentProvider @default(razorpay)
  providerOrderId   String?         @unique @map("provider_order_id")
  /// The Razorpay payment (attempt) that last moved `status`.
  providerPaymentId String?         @map("provider_payment_id")

  status PaymentStatus @default(created)

  /// Copied from `checkout_sessions.pricing_snapshot.totalPaise` at claim
  /// time — the only source of the amount sent to Razorpay.
  amountPaise Int    @map("amount_paise")
  currency    String @default("INR")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// When the maintenance job last re-read this order from Razorpay after
  /// its session closed, looking for a payment whose webhook never came.
  lateCheckedAt DateTime? @map("late_checked_at") @db.Timestamptz(6)

  issues PaymentIssue[]
  order  Order?

  @@index([status, createdAt])
  @@map("payments")
}

/// Where a late payment stands (plan §5 Phase 8, Open 5).
///
/// - `open`: money arrived (authorized or captured) for a session that no
///   longer holds stock. The maintenance job refunds it once Razorpay
///   reports it captured.
/// - `refund_initiated`: Razorpay accepted the refund (`refund_id`).
/// - `refunded`: the payment is fully refunded. Terminal.
/// - `manual_review`: something the job will not decide alone, such as a
///   partial refund, an unknown status, a failed refund or repeated API
///   errors. Terminal for the job; a human resolves it.
enum PaymentIssueState {
  open
  refund_initiated
  refunded
  manual_review

  @@map("payment_issue_state")
}

/// One durable record per Razorpay payment (attempt) that cannot be
/// fulfilled: a late payment for a session holding no stock, or a second
/// payment on an order already paid. It is written in the same transaction
/// as the observation that revealed it, so neither a log line nor a crash
/// can lose it, and `UNIQUE(provider_payment_id)` makes every redelivery
/// and race converge on one row.
model PaymentIssue {
  id String @id @default(uuid(7)) @db.Uuid

  paymentId String  @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id])

  state  PaymentIssueState @default(open)
  /// Why the payment could not be fulfilled, e.g. `session_expired`.
  reason String

  /// The Razorpay payment (attempt) the money is on — what gets refunded.
  providerPaymentId String @unique @map("provider_payment_id")
  amountPaise       Int    @map("amount_paise")
  currency          String @default("INR")

  refundId  String? @map("refund_id")
  /// Failed resolution attempts; at the limit the issue goes to `manual_review`.
  attempts  Int     @default(0)
  lastError String? @map("last_error")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([paymentId])
  @@index([state, createdAt])
  @@map("payment_issues")
}

/// Every signature-verified webhook delivery, stored before processing.
/// `UNIQUE(provider, provider_event_id)` is the replay/duplicate guard
/// (plan §5 Phase 7, task 1) — a redelivery fails the insert and is
/// acknowledged without reprocessing.
model WebhookEvent {
  id String @id @default(uuid(7)) @db.Uuid

  provider        PaymentProvider
  providerEventId String          @map("provider_event_id")
  eventType       String          @map("event_type")
  payload         Json

  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  /// Set when the event was stored but could not be applied (unknown
  /// order, amount mismatch, …) — acknowledged anyway, investigated here.
  processingError String?   @map("processing_error")

  @@unique([provider, providerEventId])
  @@index([receivedAt])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Phase 8 — Inventory + Concurrency Hardening. See
// Vokr-Implementation-Plan.md §5 PHASE 8 and the §3.5 transaction
// boundary. `src/server/inventory/` is the only writer.
// ---------------------------------------------------------------------------

/// `held → committed` on a verified capture; `held → released | expired`
/// otherwise. `committed`, `released` and `expired` are terminal.
enum ReservationState {
  held
  committed
  released
  expired

  @@map("reservation_state")
}

/// A time-boxed hold on stock for one line of one checkout session. While
/// `held`, its quantity is counted in `inventory.quantity_reserved`; every
/// state change moves that counter in the same transaction, under the
/// inventory row's `FOR UPDATE` lock. `UNIQUE(checkout_session_id,
/// variant_id)` means a duplicate reserve request cannot hold twice.
model InventoryReservation {
  id String @id @default(uuid(7)) @db.Uuid

  variantId String         @map("variant_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  checkoutSessionId String          @map("checkout_session_id") @db.Uuid
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id])

  quantity Int
  state    ReservationState @default(held)

  /// Set from the database clock inside the reservation transaction.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Also serves lookups by `checkout_session_id` (its leading column).
  @@unique([checkoutSessionId, variantId])
  @@map("inventory_reservations")
}

/// `confirmed → preparing → shipped → delivered`, plus `cancelled`,
/// `returned`, `refunded` and `rto` (plan §5 Phase 9, task 5). Transitions
/// live in `src/server/orders/state-machine.ts`; every one writes
/// `order_status_history`.
enum OrderStatus {
  confirmed
  preparing
  shipped
  delivered
  cancelled
  returned
  refunded
  rto

  @@map("order_status")
}

/// A paid (later: COD-confirmed) checkout, made durable (plan §5 Phase 9).
/// Everything here is copied from the session's pricing snapshot and
/// address at creation — never recomputed and never referenced live — so
/// an order renders identically after a rename, reprice, address edit or
/// delete, and its total always equals the amount charged.
model Order {
  id String @id @default(uuid(7)) @db.Uuid

  /// `VK-10001`, `VK-10002`, … from `order_number_seq` (task 2). Ordinal
  /// only: it says nothing but how many orders came before.
  orderNumber String @unique @default(dbgenerated("('VK-'::text || (nextval('order_number_seq'::regclass))::text)")) @map("order_number")

  checkoutSessionId String          @unique @map("checkout_session_id") @db.Uuid
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id])

  /// The captured payment that created it. Nullable for COD (Phase 10),
  /// which a CHECK enforces.
  paymentId String?  @unique @map("payment_id") @db.Uuid
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  /// Signed-in owner, if any. Guests own an order only through lookup
  /// (number + email): a guest session is short-lived and pruned.
  userId String?  @map("user_id") @db.Uuid
  user   AppUser? @relation(fields: [userId], references: [id])

  status        OrderStatus           @default(confirmed)
  paymentMethod CheckoutPaymentMethod @map("payment_method")

  /// Encrypted, copied from the session and address at creation.
  contactEmailEnc String  @map("contact_email_enc")
  shipNameEnc     String  @map("ship_name_enc")
  shipPhoneEnc    String  @map("ship_phone_enc")
  shipLine1Enc    String  @map("ship_line1_enc")
  shipLine2Enc    String? @map("ship_line2_enc")
  shipCity        String  @map("ship_city")
  shipState       String  @map("ship_state")
  shipPincode     String  @map("ship_pincode")
  shipCountry     String  @default("IN") @map("ship_country")

  /// `intra_state` (CGST+SGST) or `inter_state` (IGST), and the seller
  /// state it was decided against — as priced.
  gstSplit    String @map("gst_split")
  sellerState String @map("seller_state")

  subtotalPaise Int    @map("subtotal_paise")
  taxPaise      Int    @map("tax_paise")
  shippingPaise Int    @map("shipping_paise")
  codFeePaise   Int    @map("cod_fee_paise")
  totalPaise    Int    @map("total_paise")
  currency      String @default("INR")

  /// Courier and AWB entered by an operator from the Shiprocket panel when
  /// the order ships (plan §5 Phase 10, task 3). Both or neither (CHECK).
  courier   String?
  awb       String?
  shippedAt DateTime? @map("shipped_at") @db.Timestamptz(6)

  placedAt  DateTime @default(now()) @map("placed_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items   OrderItem[]
  history OrderStatusHistory[]
  emails  EmailLog[]

  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@map("orders")
}

/// One snapshot line (task 4): what was bought, at what price and tax, as
/// it was described then. `variant_id` is kept for reporting only and is
/// nulled if the variant is ever deleted; the order still renders.
model OrderItem {
  id String @id @default(uuid(7)) @db.Uuid

  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id])

  variantId String?         @map("variant_id") @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  sku         String
  productName String @map("product_name")
  sizeLabel   String @map("size_label")
  colorway    String
  hsnCode     String @map("hsn_code")
  gstRateBps  Int    @map("gst_rate_bps")

  quantity          Int
  unitPricePaise    Int @map("unit_price_paise")
  lineSubtotalPaise Int @map("line_subtotal_paise")
  lineTaxPaise      Int @map("line_tax_paise")
  cgstPaise         Int @map("cgst_paise")
  sgstPaise         Int @map("sgst_paise")
  igstPaise         Int @map("igst_paise")

  @@index([orderId])
  @@map("order_items")
}

/// Every status change, with who made it (task 5). The first row
/// (`from_status` NULL → `confirmed`) is written with the order.
model OrderStatusHistory {
  id String @id @default(uuid(7)) @db.Uuid

  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id])

  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  /// `system:payment` (verified webhook or reconciliation), later
  /// `admin:<user id>` (Phase 12).
  actor      String
  note       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// The transactional emails this system sends (plan §5 Phase 11).
enum EmailTemplate {
  order_confirmation
  order_shipped

  @@map("email_template")
}

/// `pending → sending → sent | failed`. `sending` that never completes is
/// not retried automatically (Brevo has no idempotency key, so a resend
/// could duplicate the email): it goes to `failed` for a person.
enum EmailStatus {
  pending
  sending
  sent
  failed

  @@map("email_status")
}

/// Outbox and record of transactional email (plan §5 Phase 11, tasks 2, 4,
/// 5). A row is written `pending` in the same transaction as the event it
/// announces (an order's creation), and the maintenance job sends it after
/// commit — an email can never fail or delay a payment.
/// `UNIQUE(order_id, template)`: one email per order event, ever.
/// **Never stores the rendered body or the address** — only a SHA-256 of
/// the normalised recipient, set when sent.
model EmailLog {
  id String @id @default(uuid(7)) @db.Uuid

  orderId String? @map("order_id") @db.Uuid
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  template EmailTemplate
  status   EmailStatus   @default(pending)

  recipientHash     String? @map("recipient_hash")
  providerMessageId String? @map("provider_message_id")
  attempts          Int     @default(0)
  lastError         String? @map("last_error")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)

  @@unique([orderId, template])
  @@index([status, updatedAt])
  @@index([sentAt])
  @@map("email_log")
}

/// Every operator action (plan §5 Phase 12, task 10): who, what, on which
/// row, the state before and after, and the stated reason. Written in the
/// same transaction as the change it records, so neither can exist
/// without the other. Append-only — a trigger refuses UPDATE. Holds no PII:
/// a PII reveal records *that* it happened, never what was shown.
model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  /// `admin:<app_users.id>`.
  actor    String
  /// e.g. `inventory.adjust`, `order.transition`, `order.refund`, `pii.reveal`, `export.shiprocket`.
  action   String
  entity   String
  entityId String  @map("entity_id")
  before   Json?
  after    Json?
  reason   String?
  requestId String? @map("request_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entity, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Phase 17 — DPDP. `consent_records` (append-only) and
// `data_subject_requests` (erasure requests, executed only after an
// operator approves a dry-run). See `src/server/privacy/*` and
// `docs/privacy/data-inventory.md`.
// ---------------------------------------------------------------------------

/// What a consent record is for. Purpose-specific, never a blanket flag
/// (plan §9): one row per purpose per event.
enum ConsentPurpose {
  /// Creating an account, which the terms state is acceptance of the
  /// Terms and the Privacy Policy.
  account_terms
  /// The footer newsletter: marketing email from Brevo.
  marketing_email

  @@map("consent_purpose")
}

enum ConsentAction {
  granted
  withdrawn

  @@map("consent_action")
}

/// Proof of consent (plan §5 Phase 17, tasks 1–2). **Append-only** — a
/// trigger refuses UPDATE, and DELETE unless the retention purge opts in
/// for its own transaction; withdrawal is a new row. A newsletter
/// subscriber has no account, so the subject is identified by a SHA-256
/// of the normalised email (pseudonymised, not anonymised); `user_id` is
/// set when the subject is signed in. The IP is stored only as a digest.
model ConsentRecord {
  id String @id @default(uuid(7)) @db.Uuid

  userId String?  @map("user_id") @db.Uuid
  user   AppUser? @relation(fields: [userId], references: [id], onDelete: Restrict)

  subjectHash   String         @map("subject_hash")
  purpose       ConsentPurpose
  action        ConsentAction
  /// The Privacy Policy version shown (its "last updated" label).
  policyVersion String         @map("policy_version")
  /// Where it was given, e.g. `signup_form`, `newsletter_form`.
  source        String
  ipHash        String?        @map("ip_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([subjectHash, purpose, createdAt])
  @@index([userId, createdAt])
  @@map("consent_records")
}

enum DataSubjectRequestKind {
  erasure

  @@map("data_subject_request_kind")
}

/// `requested → approved → completed`, or `rejected`. Nothing is erased
/// on request: an operator reviews a dry-run report and approves, and
/// execution is further gated by `ERASURE_EXECUTION_ENABLED`.
enum DataSubjectRequestState {
  requested
  approved
  rejected
  completed

  @@map("data_subject_request_state")
}

/// A data-subject request (plan §5 Phase 17, task 1). Holds no PII: the
/// subject is the account id; reports are counts only.
model DataSubjectRequest {
  id String @id @default(uuid(7)) @db.Uuid

  userId String  @map("user_id") @db.Uuid
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  kind  DataSubjectRequestKind
  state DataSubjectRequestState @default(requested)

  /// `admin:<id>` of the operator who approved or rejected it.
  decidedBy      String?  @map("decided_by")
  decisionReason String?  @map("decision_reason")
  /// Counts of what was (or would be) anonymised and retained.
  report         Json?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([state, createdAt])
  @@index([userId])
  @@map("data_subject_requests")
}
