{
  "displayName": "Vokr: vokr_reconcile_failed",
  "severity": "WARNING",
  "documentation": {
    "content": "alerting.md: transient if it clears next run. Fires only when two or more reads fail within 15 min (three maintenance runs). Runbook: vokr/docs/infrastructure/alerting.md",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "vokr_reconcile_failed > 1 in 15 min",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/vokr_reconcile_failed\" AND resource.type=\"cloud_run_revision\"",
        "aggregations": [
          {
            "alignmentPeriod": "900s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 1,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "alertStrategy": {
    "autoClose": "86400s"
  },
  "notificationChannels": [
    "${NOTIFICATION_CHANNEL}"
  ]
}
