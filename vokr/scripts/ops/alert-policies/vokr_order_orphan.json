{
  "displayName": "Vokr: vokr_order_orphan",
  "severity": "CRITICAL",
  "documentation": {
    "content": "Money and orders disagree; every occurrence is urgent. Runbook: vokr/docs/infrastructure/alerting.md",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "vokr_order_orphan > 0 in 5 min",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/vokr_order_orphan\" AND resource.type=\"cloud_run_revision\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "alertStrategy": {
    "autoClose": "86400s"
  },
  "notificationChannels": [
    "${NOTIFICATION_CHANNEL}"
  ]
}
